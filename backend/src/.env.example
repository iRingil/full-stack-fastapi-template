# Copy to .env and fill in. Empty variables are required; commented ones show their defaults and may stay unset.
# Environment variables take precedence over this file.

# Application
PROJECT_NAME=
# ENVIRONMENT=local                     # local, staging or production
# FRONTEND_HOST=http://localhost:5173   # used in the links of emails and allowed by CORS
# BACKEND_CORS_ORIGINS=                 # more allowed origins: comma-separated or a JSON list

# Security
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=11520     # 8 days
# EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
# EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24

# First superuser (created by python -m app.initial_data)
FIRST_SUPERUSER=                        # email
FIRST_SUPERUSER_PASSWORD=

# PostgreSQL
POSTGRES_SERVER=                        # an IPv4 or IPv6 address or a host name
POSTGRES_USER=
POSTGRES_DB=
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# POSTGRES_SOCKET=                      # a Unix socket directory, used instead of the server in production

# Emails: sent only when both SMTP_HOST and EMAILS_FROM_EMAIL are set
# SMTP_HOST=                            # an IPv4 or IPv6 address or a host name
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true                         # STARTTLS; cannot be combined with SMTP_SSL
# SMTP_SSL=false
# EMAILS_FROM_EMAIL=
# EMAILS_FROM_NAME=                     # the project name by default
